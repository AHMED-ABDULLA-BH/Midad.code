        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="midad">
            <uap:SupportedFileTypes><uap:FileType>.midad</uap:FileType></uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities><rescap:Capability Name="runFullTrust"/></Capabilities>
</Package>
